              "name": "deal.properties.Stage.value",
              "value": "={{ (() => {\n  const props = ($json.deal && $json.deal.properties) || {};\n  const stage = props.Stage || {};\n  const opts = ((stage.select || {}).options || []).map(o => o.name);\n  const advice = String((props['Investment Advice'] || {}).value || '').trim().toLowerCase();\n  const want = advice.startsWith('pass') ? 'Direct Reject' : (opts[0] || '');\n  return opts.includes(want) ? want : (opts[0] || '');\n})() }}",
