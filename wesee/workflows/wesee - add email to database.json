        "method": "POST",
        "url": "=https://api.notion.com/v1/pages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((() => {\n  const obj = {\n    parent: { database_id: $json.deal.notion.id },\n    properties: Object.fromEntries(\n      Object.entries($json.deal.properties)\n        .filter(([_, entry]) => entry.value !== \"\" && entry.value !== \"\\\"\\\"\" && entry.value !== null && entry.value !== undefined)\n        .map(([key, entry]) => [\n          key,\n          key === \"Company\"\n            ? { title: [{ text: { content: entry.value } }] }\n            : entry.type === \"rich_text\" || entry.type === \"text\"\n            ? { rich_text: [{ text: { content: entry.value } }] }\n            : entry.type === \"multi_select\"\n            ? { multi_select: Array.isArray(entry.value) ? entry.value.map(option => ({ name: option.trim() })) : entry.value.split(\",\").map(option => ({ name: option.trim() })) }\n            : entry.type === \"select\"\n            ? { select: { name: entry.value } }\n            : entry.type === \"url\"\n            ? { url: entry.value }\n            : entry.type === \"number\"\n            ? { number: Number(entry.value) }\n            : entry.type === \"email\"\n            ? { email: entry.value }\n            : null\n        ])\n        .filter(([_, value]) => value !== null)\n    )\n  };\n\n  // Recursive function to remove empty fields, including empty objects and nested empty objects\n  const removeEmptyFields = (obj) => {\n    if (Array.isArray(obj)) {\n      const filteredArray = obj.map(removeEmptyFields).filter(item => item !== null && item !== \"\" && item !== \"\\\"\\\"\");\n      return filteredArray.length > 0 ? filteredArray : null;\n    } else if (typeof obj === \"object\" && obj !== null) {\n      const filteredObject = Object.fromEntries(\n        Object.entries(obj)\n          .map(([key, value]) => [key, removeEmptyFields(value)])\n          .filter(([_, value]) => \n            value !== null && \n            value !== \"\" && \n            value !== \"\\\"\\\"\" && \n            !(typeof value === \"object\" && Object.keys(value).length === 0) // Removes empty objects!\n          )\n      );\n\n      // If the object is empty after filtering, return null (removes parent field)\n      return Object.keys(filteredObject).length > 0 ? filteredObject : null;\n    }\n    return obj;\n  };\n\n  // Ensure the whole object is removed if it becomes empty\n  return removeEmptyFields(obj) || null;\n})());\n}}",
        "options": {}
