            {
              "id": "e5f60718-dddd-4a55-9b7c-1d2e3f4a5b62",
              "name": "deal.properties.Pitch Deck.value",
              "value": "={{ (() => {\n  const t = $('add email link property').item.json;\n  const atts = t.attachments ? Object.values(t.attachments) : [];\n  const NAME = /deck|pitch|teaser|presentation|investor/i;\n  const SECTIONS = ['problem','solution','market','traction','team','business model','roadmap','raising','tam','use of funds','runway','competition','go-to-market','milestones'];\n  const looksLikeDeck = (a) => {\n    if (NAME.test(String(a.fileName || ''))) return true;\n    const x = String(a.parsed || '').toLowerCase();\n    if (x.length < 400) return false;\n    return SECTIONS.filter((s) => x.includes(s)).length >= 5;\n  };\n  const deck = atts.find(looksLikeDeck);\n  if (!deck) return \"\";\n  const files = Array.isArray($json.value) ? $json.value : [];\n  const byName = files.find((f) => f.name === deck.fileName);\n  const byHint = files.find((f) => NAME.test(String(f.name)));\n  const hit = byName || byHint;\n  return hit && hit.webUrl ? hit.webUrl : \"\";\n})() }}",
              "type": "string"
            }
          ]
        },
