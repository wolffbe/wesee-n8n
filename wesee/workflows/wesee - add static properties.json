              "id": "dd22bb33-1-4c5d-8e9f-ff0000000000",
              "name": "deal.properties.Email.value",
              "value": "={{ (() => {\n  const props = ($json.deal && $json.deal.properties) || {};\n  const company = String((props.Company || {}).value || '').trim();\n  const subject = String(($json.email || {}).subject || '').trim();\n  const q = company || subject;\n  if (!q) return \"\";\n  return 'https://outlook.live.com/mail/0/search?q=' + encodeURIComponent(q);\n})() }}",
