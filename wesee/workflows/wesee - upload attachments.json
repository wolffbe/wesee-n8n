    },
    {
      "parameters": {
        "method": "PUT",
        "url": "={{\n(() => {\n  const driveId  = $('loop over attachments').item.json.deal.folders.drive.id;\n  const folderId = $('loop over attachments').item.json.deal.folders.email.id;\n  const a        = $('loop over attachments').item.json.attachment;\n\n  // ensure extension exactly once\n  const ext  = (a.fileExtension ?? '').trim();\n  let   name = (a.fileName ?? 'file').trim();\n  if (ext && !name.toLowerCase().endsWith('.' + ext.toLowerCase())) {\n    name = `${name}.${ext}`;\n  }\n\n  // normalize + remove illegal characters for OneDrive/Windows\n  name = name\n    .normalize('NFKD')                // split accent marks (Ä -> A + ¨)\n    .replace(/[\\u0300-\\u036f]/g, '')  // drop combining marks\n    .replace(/[\\\\\\/]/g, '-')          // slashes -> hyphen\n    .replace(/[:*?\"<>|]/g, ' - ')     // illegal chars -> \" - \"\n    .replace(/[.\\s]+$/,'')            // no trailing dots/spaces\n    .replace(/\\s+/g,' ')              // collapse whitespace\n    .trim();\n\n  // assemble URL: encode each dynamic segment, NOT the Graph colons\n  return `https://graph.microsoft.com/v1.0/drives/${encodeURIComponent(driveId)}` +\n         `/items/${encodeURIComponent(folderId)}:/` +\n         `${encodeURIComponent(name)}:/content`;\n})()\n}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
