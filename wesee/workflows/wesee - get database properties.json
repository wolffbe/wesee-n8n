        "assignments": {
          "assignments": [
            {
              "id": "b1d2c3e4-0001-4a1b-9c2d-aa0000000001",
              "name": "pendingFields",
              "value": "={{ (() => {\n  const defs = {\n \"Stage\": {\n  \"type\": \"select\",\n  \"select\": {\n   \"options\": [\n    {\n     \"name\": \"Inflow (deals@)\",\n     \"color\": \"default\"\n    },\n    {\n     \"name\": \"To Approach\",\n     \"color\": \"yellow\"\n    },\n    {\n     \"name\": \"Initial conversation\",\n     \"color\": \"purple\"\n    },\n    {\n     \"name\": \"To Pass\",\n     \"color\": \"blue\"\n    },\n    {\n     \"name\": \"To Present to Team\",\n     \"color\": \"orange\"\n    },\n    {\n     \"name\": \"Opportunity Qualification\",\n     \"color\": \"green\"\n    },\n    {\n     \"name\": \"Watchlist\",\n     \"color\": \"brown\"\n    },\n    {\n     \"name\": \"Invest\",\n     \"color\": \"green\"\n    },\n    {\n     \"name\": \"Direct Reject\",\n     \"color\": \"gray\"\n    },\n    {\n     \"name\": \"Rejected\",\n     \"color\": \"red\"\n    },\n    {\n     \"name\": \"Interested\",\n     \"color\": \"purple\"\n    }\n   ]\n  }\n },\n \"Website\": {\n  \"type\": \"url\",\n  \"url\": {},\n  \"description\": \"The company's own website URL. Only use a URL that actually appears in the email or its attachments.\"\n },\n \"Pitch Deck\": {\n  \"type\": \"url\",\n  \"url\": {}\n },\n \"Description\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"A short summary of the company. It should be as concise and factual as possible, and use as little marketing language as possible.\"\n },\n \"Thesis Fit\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"How well the company matches the VC's investment thesis, naming the specific points of fit and of mismatch, including sector, stage and whether the amount being raised is compatible with the fund's ticket size.\"\n },\n \"Investment Advice\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"Your view on whether the VC should invest, judged against their thesis. Start with exactly one of: Invest, Explore further, or Pass. Then one or two sentences citing the strongest supporting evidence and the most serious concern. Use only what the material states.\"\n },\n \"Round\": {\n  \"type\": \"select\",\n  \"select\": {\n   \"options\": [\n    {\n     \"name\": \"Pre-seed\",\n     \"color\": \"gray\"\n    },\n    {\n     \"name\": \"Seed\",\n     \"color\": \"blue\"\n    },\n    {\n     \"name\": \"Series A\",\n     \"color\": \"green\"\n    },\n    {\n     \"name\": \"Series B\",\n     \"color\": \"yellow\"\n    },\n    {\n     \"name\": \"Series C+\",\n     \"color\": \"orange\"\n    },\n    {\n     \"name\": \"Unknown\",\n     \"color\": \"default\"\n    }\n   ]\n  },\n  \"description\": \"The funding round the company is currently raising. Choose exactly one of the predefined options, and Unknown if the round is not stated.\"\n },\n \"Raise Amount\": {\n  \"type\": \"number\",\n  \"number\": {},\n  \"description\": \"The amount of money the company is currently raising, in US dollars, as a full number without abbreviation.\"\n },\n \"Revenue\": {\n  \"type\": \"number\",\n  \"number\": {},\n  \"description\": \"Current annual recurring revenue (ARR) in US dollars, as a full number without abbreviation, if stated.\"\n },\n \"Sector\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The industry or vertical the company operates in, for example healthtech, fintech, climate or enterprise software.\"\n },\n \"Location\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The company headquarters as city and country, if stated.\"\n },\n \"Team\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The founders and key team members, with the relevant parts of their background such as prior companies or domain expertise.\"\n },\n \"Contact\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The person presenting the company, normally a founder, with their role if given. Take it from the signature, sender or deck. If forwarded, use the original sender, not the forwarder. Never use a name from the blacklist above - they work at the VC, not the startup.\"\n },\n \"Market\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"What market this company is really in and who the actual buyer is, in your own words rather than quoting the pitch. Note their claimed TAM, SAM or SOM figures, and say if those look inflated or poorly defined versus what they can realistically sell into.\"\n },\n \"Moat\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"What would make this business defensible over time - proprietary technology, data, distribution, switching costs, network effects or regulatory position - and how convincing that defensibility actually is on the evidence given.\"\n },\n \"Risks\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The most serious risks and red flags, including anything exaggerated, unverifiable or inconsistent: implausible metrics, name-dropped advisors or investors presented as endorsements, or claims with no supporting evidence.\"\n },\n \"Growth\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The growth rate the company reports, for example year-on-year revenue growth or month-on-month user growth.\"\n },\n \"Customers\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"The number and type of customers, including named reference customers or logos if they are given.\"\n },\n \"Traction\": {\n  \"type\": \"rich_text\",\n  \"rich_text\": {},\n  \"description\": \"Key traction and efficiency metrics such as net revenue retention, churn, CAC payback, burn rate or runway.\"\n },\n \"Source\": {\n  \"type\": \"email\",\n  \"email\": {}\n },\n \"Files\": {\n  \"type\": \"url\",\n  \"url\": {}\n },\n \"Email\": {\n  \"type\": \"url\",\n  \"url\": {}\n }\n};\n  const existing = $json.properties || {};\n  const have = new Set(Object.keys(existing).map(k => k.toLowerCase()));\n  const out = {};\n  const title = Object.entries(existing).find(([, p]) => p && p.type === \"title\");\n  if (title) {\n    const needsRename = title[0].toLowerCase() !== \"company\";\n    const needsDesc = !String(title[1].description || \"\").trim();\n    if (needsRename || needsDesc) out[title[0]] = { name: \"Company\", description: \"The name of the company, ideally including its legal form\", title: {} };\n  }\n  for (const name of Object.keys(defs)) {\n    if (!have.has(name.toLowerCase())) out[name] = defs[name];\n  }\n  return out;\n})() }}",
