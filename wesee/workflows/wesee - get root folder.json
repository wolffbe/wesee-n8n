              "value": "={{ \n  Object.keys($json.deal.folders.root.folders)\n    .map(Number) // Ensure keys are treated as numbers for sorting\n    .sort((a, b) => a - b) // Sort keys in ascending order\n    .slice(0, -1) // Exclude the last key to avoid out-of-bounds errors\n    .map(key => ({\n      parent: {\n        index: key,\n        id: $json.deal.folders.root.folders[key].id,\n        name: $json.deal.folders.root.folders[key].name\n      },\n      child: {\n        index: Number(key) + 1,\n        id: $json.deal.folders.root.folders[Number(key) + 1]?.id,\n        name: $json.deal.folders.root.folders[Number(key) + 1]?.name\n      }\n    }))\n}}",
